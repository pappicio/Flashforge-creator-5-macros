[gcode_macro START_PRINT]
gcode:
    {% set BED_TEMP = params.BED_TEMP|default(60)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(200)|float %}
    {% set EXTRUDER = params.EXTRUDER|default(0)|int %}
    {% set TOTAL_LAYER = params.TOTAL_LAYER|default(1)|int %}
    {% set PURGE_SPEED = params.PURGE_SPEED|default(300)|float %}

    M140 S{BED_TEMP}
    M106 P101 S0
    M106 P2 S0
    M106 S0
    M106 P3 S0
    G90
    M83
    SAFE_Z_HOP MIN_Z=10
    SET_PRINT_STATS_INFO TOTAL_LAYER={TOTAL_LAYER}
    CARICA_MESH_TEMPERATURA
    T{EXTRUDER}
    M109 S{EXTRUDER_TEMP} T{EXTRUDER}
    G1 X256 Y0 Z0.2 F6000
    G1 E5 F{PURGE_SPEED}
    G1 X216 E10 F{PURGE_SPEED}

##########################################################

[gcode_macro END_PRINT]
gcode:
    # 1. Calcola la quota Z sicura
    {% set max_z = printer.toolhead.axis_maximum.z|float %}
    {% set act_z = printer.toolhead.position.z|float %}
    {% if act_z < (max_z - 10.0) %}
        {% set z_safe = 10.0 %}
    {% else %}
        {% set z_safe = max_z - act_z %}
    {% endif %}

    # 2. Retrazione e movimento Z dinamico
    G91
    G1 E-1.2 Z{z_safe} F3000   ; Abbassa il piatto di 10mm O solo dello spazio rimasto
    G90

    # 3. Park X/Y e Spegnimento completo
    G1 X150 Y150 F12000        ; Spostamento rapido di park
##########################################################

# ====================================================================
# 1. Override che neutralizza la scansione automatica Flashforge
# ====================================================================
[gcode_macro BED_MESH_CALIBRATE]
rename_existing: REAL_BED_MESH_CALIBRATE
gcode:
    M118 Intercettato comando Flashforge: livellamento ignorato. Uso mesh pre-salvata.


# ====================================================================
# Macro per il caricamento dinamico della mesh con controllo di sicurezza
# ====================================================================
[gcode_macro CARICA_MESH_TEMPERATURA]
gcode:
    {% set BED_TEMP = params.BED|default(printer.heater_bed.target)|float %}

    # 1. Determinazione del nome profilo target
    {% if BED_TEMP >= 110 %}
        {% set MESH_TARGET = "110" %}
    {% elif BED_TEMP >= 100 %}
        {% set MESH_TARGET = "100" %}
    {% elif BED_TEMP >= 90 %}
        {% set MESH_TARGET = "90" %}
    {% elif BED_TEMP >= 80 %}
        {% set MESH_TARGET = "80" %}
    {% elif BED_TEMP >= 70 %}
        {% set MESH_TARGET = "70" %}
    {% elif BED_TEMP >= 60 %}
        {% set MESH_TARGET = "60" %}
    {% elif BED_TEMP >= 50 %}
        {% set MESH_TARGET = "50" %}
    {% else %}
        {% set MESH_TARGET = "40" %}
    {% endif %}

    # 2. Recupera la lista dei profili mesh salvati su disco
    {% set SALVATI = printer.bed_mesh.profiles %}

    # 3. Controllo ed eventuale caricamento o blocco stampa
    {% if MESH_TARGET in SALVATI %}
        M118 Caricamento mesh salvata per profilo {MESH_TARGET} (Target: {BED_TEMP}C)
        BED_MESH_PROFILE LOAD={MESH_TARGET}
    {% else %}
        M118 ====================================================
        M118 !!! MESH {MESH_TARGET} NON PRESENTE SU DISCO !!!
        M118 Annullamento stampa e avvio calibrazione automatica...
        M118 ====================================================

        # 1. Annulla la stampa attiva
        CANCEL_PRINT

        # 2. Mantiene il piatto in temperatura target per la profilazione
        M140 S{BED_TEMP}

        # 3. Deposita l'utensile nel dock
        DEPOSITA_TOOL

        # 4. Avvia la profilazione e il SAVE_CONFIG
        SALVA_MESH_TEMPERATURA B={BED_TEMP|int}

        # 5. Sblocca i motori prima di lanciare la nuova procedura
        DISABILITA_MOTORI
    {% endif %}



[gcode_macro SALVA_MESH_TEMPERATURA]
description: Verifica la sicurezza degli utensili e avvia la calibrazione della mesh
gcode:
    _VERIFICA_E_ESECUZIONE_MESH {rawparams}


[gcode_macro _VERIFICA_E_ESECUZIONE_MESH]
gcode:
    # 1. Lettura dello stato dei sensori
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}

    {% set pos = [
        printer["gcode_button extruder_pos1"].state,
        printer["gcode_button extruder_pos2"].state,
        printer["gcode_button extruder_pos3"].state,
        printer["gcode_button extruder_pos4"].state
    ] %}

    # Variabili per raccogliere lo stato
    {% set ns = namespace(mounted=[], missing=[], ok_count=0) %}

    # 2. Controllo puntuale tool per tool
    {% for i in range(4) %}
        {% set tool_num = i + 1 %}
        {% set p = pos[i] %}
        {% set g = grab[i] %}

        {% if p == "PRESSED" and g == "RELEASED" %}
            {% set ns.ok_count = ns.ok_count + 1 %}
        {% elif g == "PRESSED" %}
            {% set _ = ns.mounted.append("Tool %d" % tool_num) %}
        {% elif p == "RELEASED" and g == "RELEASED" %}
            {% set _ = ns.missing.append("Tool %d" % tool_num) %}
        {% endif %}
    {% endfor %}

    # 3. Blocco di sicurezza con messaggi specifici sul primo utensile rilevato
    {% if ns.mounted|length > 0 %}
        M118 ERRORE: Utensile montato sul carrello: {ns.mounted[0]}
        { action_raise_error("ABORTITO: Sgancia il %s dal carrello prima di eseguire G28 / Mesh!" % ns.mounted[0]) }

    {% elif ns.missing|length > 0 %}
        M118 ERRORE: Utensile fuori sede o caduto: {ns.missing[0]}
        { action_raise_error("ABORTITO: %s non in deposito e non sul carrello! Verificare posizione." % ns.missing[0]) }

    {% else %}
        # 4. Procedura MESH (Tutti e 4 a deposito)
        M118 Carrello libero e tutti i 4 tool in sede. Avvio procedura MESH...

        {% set B_PARAM = params.B|default(printer.heater_bed.target)|float %}
        {% set TARGET_TEMP = 60.0 if B_PARAM == 0 else B_PARAM %}

        {% if TARGET_TEMP >= 110 %}
            {% set mesh = "110" %}
        {% elif TARGET_TEMP >= 100 %}
            {% set mesh = "100" %}
        {% elif TARGET_TEMP >= 90 %}
            {% set mesh = "90" %}
        {% elif TARGET_TEMP >= 80 %}
            {% set mesh = "80" %}
        {% elif TARGET_TEMP >= 70 %}
            {% set mesh = "70" %}
        {% elif TARGET_TEMP >= 60 %}
            {% set mesh = "60" %}
        {% elif TARGET_TEMP >= 50 %}
            {% set mesh = "50" %}
        {% else %}
            {% set mesh = "40" %}
        {% endif %}

        M118 Riscaldamento piatto a {TARGET_TEMP}C per profilo {mesh}...
        M140 S{TARGET_TEMP}
        M190 S{TARGET_TEMP}
        G28
        M118 Piatto in temperatura. Avvio calibrazione mesh {mesh}...
        BED_MESH_CLEAR
        REAL_BED_MESH_CALIBRATE
        BED_MESH_PROFILE SAVE={mesh}
        BED_MESH_PROFILE LOAD={mesh}
        M118 Mesh {mesh} salvata! Salvataggio configurazione e riavvio in corso...
        SAVE_AND_REBOOT
    {% endif %}


[gcode_macro DUMP_VARS]
description: Stampa TUTTE le variabili e gli oggetti presenti in Klipper
gcode:
    {% set ns = namespace(path=[]) %}
    {% for item in printer %}
        {% if ' ' in item %}
            {% set ns.path = ['printer', "['%s']" % (item)] %}
        {% else %}
            {% set ns.path = ['printer.', item] %}
        {% endif %}
        {% if printer[item] is mapping %}
            {% for childkey, child in printer[item].items() recursive %}
                {% set ns.path = ns.path[:loop.depth|int] %}
                {% if ' ' in childkey %}
                    {% set null = ns.path.append("['%s']" % (childkey)) %}
                {% else %}
                    {% set null = ns.path.append(".%s" % (childkey)) %}
                {% endif %}
                {% if child is mapping %}
                    { loop(child.items()) }
                {% else %}
                    { action_respond_info("%s : %s" % (ns.path|join, child)) }
                {% endif %}
            {% endfor %}
        {% else %}
            { action_respond_info("%s : %s" % (ns.path|join, printer[item])) }
        {% endif %}
    {% endfor %}


[gcode_macro TEST_TOOL_SAFETY]
description: Test visivo in console per lo stato dei sensori dei tool
gcode:
    # 1. Lettura dello stato dei sensori
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}

    {% set pos = [
        printer["gcode_button extruder_pos1"].state,
        printer["gcode_button extruder_pos2"].state,
        printer["gcode_button extruder_pos3"].state,
        printer["gcode_button extruder_pos4"].state
    ] %}

    M118 ====================================
    M118 --- REPORT SICUREZZA UTENSILI ---
    M118 ====================================

    {% set ns = namespace(errors=0, mounted=0) %}

    # Loop di controllo sui 4 utensili
    {% for i in range(4) %}
        {% set t_num = i + 1 %}
        {% set p = pos[i] %}
        {% set g = grab[i] %}

        {% if p == "PRESSED" and g == "RELEASED" %}
            M118 Tool {t_num}: [ OK ] -> Correttamente A DEPOSITO (POS: PRESSED | GRAB: RELEASED)
        {% elif p == "RELEASED" and g == "PRESSED" %}
            {% set ns.mounted = ns.mounted + 1 %}
            M118 Tool {t_num}: [ CARRELLO ] -> Montato sul MOTORE (POS: RELEASED | GRAB: PRESSED)
        {% elif p == "RELEASED" and g == "RELEASED" %}
            {% set ns.errors = ns.errors + 1 %}
            M118 Tool {t_num}: [ ALLARME ] -> PENZOLANTE / FUORI SEDE! (POS: RELEASED | GRAB: RELEASED)
        {% else %}
            M118 Tool {t_num}: [ TRANSIZIONE ] -> In movimento / Aggancio (POS: PRESSED | GRAB: PRESSED)
        {% endif %}
    {% endfor %}

    M118 ------------------------------------

    # Risultato finale per G28 / Mesh
    {% if ns.mounted > 0 %}
        M118 ESITO: [ BLOCCATO ] -> Almeno un utensile e ancora montato sul carrello.
    {% elif ns.errors > 0 %}
        M118 ESITO: [ ALLARME BLOCCANTE ] -> Almeno un utensile risulta staccato ma non al deposito!
    {% else %}
        M118 ESITO: [ OK PASS ] -> Tutti i 4 utensili a deposito. G28 / Mesh AUTORIZZATI!
    {% endif %}
    M118 ====================================

#################################################################################

[gcode_macro SAFE_Z_HOP]
description: Solleva Z fino ad almeno MIN_Z (default 10mm) se non lo e' gia'. Non abbassa mai. Se Z non e' homata, esegue G28 in automatico prima di procedere.
gcode:
    {% set MIN_Z = params.MIN_Z|default(10.0)|float %}
    {% set SPEED_Z = params.SPEED_Z|default(600)|int %}

    {% if 'z' not in printer.toolhead.homed_axes %}
        M118 Asse Z non homato, eseguo G28 prima di procedere...
        G28
    {% endif %}

    {% set current_z = printer.toolhead.position.z %}
    {% if current_z < MIN_Z %}
        M118 Z attuale {current_z}mm, sollevo a {MIN_Z}mm di sicurezza...
        G90
        G1 Z{MIN_Z} F{SPEED_Z}
        M400
    {% else %}
        M118 Z gia' a {current_z}mm, nessun sollevamento necessario.
    {% endif %}

#################################################################################

[gcode_macro _DEPOSITA_TOOL_FISICO]
gcode:
    {% set F_NORMAL = 4800 %}
    {% set F_AGGANCIO = 2400 %}

    {% set y_map = {1: 55.813, 2: 105.096, 3: 155.597, 4: 205.296} %}
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}
    {% set ns = namespace(mounted=[]) %}
    {% for i in range(4) %}
        {% if grab[i] == "PRESSED" %}
            {% set _ = ns.mounted.append(i+1) %}
        {% endif %}
    {% endfor %}

    {% if ns.mounted|length == 0 %}
        M118 Nessun tool da depositare.
    {% elif ns.mounted|length > 1 %}
        { action_raise_error("ABORTITO: piu di un sensore grab PRESSED contemporaneamente") }
    {% else %}
        {% set TOOL = ns.mounted[0] %}

        # Protezione: assicura almeno 10mm dal piatto prima di muovere in XY
        SAFE_Z_HOP MIN_Z=10

        M118 Deposito fisico Tool {TOOL} in corso...
        G90
        G1 X250 F{F_NORMAL}
        M400
        G1 Y{y_map[TOOL]} F{F_NORMAL}
        M400
        M118 Avvicinamento lento a X295...
        G1 X295 F{F_AGGANCIO}
        M400

        # Sblocco meccanico
        STEPPER_UNLOCK
        M400

        G1 X250 F{F_NORMAL}
        M400
        M118 Tool {TOOL} depositato con successo.
    {% endif %}

#################################################################################

[gcode_macro DEPOSITA_TOOL]
description: Deposita l utensile attualmente montato
gcode:
    {% if 'x' not in printer.toolhead.homed_axes or 'y' not in printer.toolhead.homed_axes %}
        M118 Macchina non homata: avvio G28 (l homing_override depositera il tool automaticamente)...
        G28
    {% else %}
        M118 Macchina gia homata: eseguo deposito diretto...
        _DEPOSITA_TOOL_FISICO
    {% endif %}

#################################################################################

[gcode_macro PRELEVA_TOOL]
description: Preleva il tool N, depositando prima l'eventuale tool gia' montato se diverso
gcode:
    {% set F_NORMAL = 4800 %}
    {% set F_AGGANCIO = 2400 %}

    {% set TOOL = params.T|default(0)|int %}
    {% set y_map = {1: 55.813, 2: 105.096, 3: 155.597, 4: 205.296} %}

    {% if TOOL not in y_map %}
        { action_raise_error("ABORTITO: numero tool non valido o parametro T mancante (usa T=1, T=2, T=3 o T=4)") }
    {% else %}
        {% set grab = [
            printer["gcode_button extruder_grab1"].state,
            printer["gcode_button extruder_grab2"].state,
            printer["gcode_button extruder_grab3"].state,
            printer["gcode_button extruder_grab4"].state
        ] %}
        {% set ns = namespace(mounted=[]) %}
        {% for i in range(4) %}
            {% if grab[i] == "PRESSED" %}
                {% set _ = ns.mounted.append(i+1) %}
            {% endif %}
        {% endfor %}

        {% if ns.mounted|length > 1 %}
            { action_raise_error("ABORTITO: piu' di un sensore grab PRESSED contemporaneamente, stato anomalo") }
        {% elif ns.mounted|length == 1 and ns.mounted[0] == TOOL %}
            M118 Tool {TOOL} e' gia' montato, nessuna azione necessaria.
        {% else %}
            {% if ns.mounted|length == 1 %}
                M118 Tool {ns.mounted[0]} montato, deposito prima di prelevare Tool {TOOL}...
                DEPOSITA_TOOL
            {% endif %}

            # Protezione: assicura homing ed almeno 10mm dal piatto prima di muovere in XY
            SAFE_Z_HOP MIN_Z=10

            M118 Prelievo Tool {TOOL} in corso...
            G90
            G1 X250 F{F_NORMAL}
            M400
            G1 Y{y_map[TOOL]} F{F_NORMAL}
            M400
            M118 Avvicinamento lento a X295...
            G1 X295 F{F_AGGANCIO}
            M400
            MOTOR_GRAB
            M400
            MOTOR_GRAB2
            M400
            G1 X250 F{F_NORMAL}
            M400
            M118 Tool {TOOL} agganciato.
        {% endif %}
    {% endif %}

#################################################################################

[gcode_macro LOAD_FILAMENT]
description: Gestisce il ciclo completo: preleva il tool T (1-4), va a spurgare, retrae, pulisce, raffredda e deposita.
gcode:
    # ==========================================
    # PARAMETRI CONFIGURABILI E TUNING
    # ==========================================
    {% set TOOL_HUMAN = params.T|default(1)|int %}

    # Parametri di estrusione e ritrazione
    {% set PURGE_LENGTH = 100.0 %}        # Millimetri di filamento da spurgare
    {% set PURGE_FEEDRATE = 300 %}        # Velocita' di spurgo (mm/min)
    {% set RETRACT_LENGTH = -5.0 %}       # Millimetri di ritrazione anti-colatura
    {% set RETRACT_FEEDRATE = 240 %}      # Velocita' di ritrazione (mm/min)

    # Temperature target
    {% set TEMP_PURGE = 240 %}            # Temperatura per lo spurgo
    {% set TEMP_SAFE = 140 %}             # Temperatura di sicurezza prima del deposito

    # Coordinate di spurgo
    {% set X_SPURGO = 273.000 %}
    {% set Y_SPURGO = 255.000 %}

    # Coordinate per il raffreddamento sul cuscinetto di silicone
    {% set X_SILICONE = 266.500 %}
    {% set Y_SILICONE = 13.800 %}
    {% set Z_SILICONE = 0.969 %}

    # Velocita' di movimento
    {% set SPEED_XY = 4800 %}             # Velocita' traslazione XY (mm/min)
    {% set SPEED_Z = 600 %}               # Velocita' discesa Z (mm/min)

    # ==========================================

    # Controllo validita' range tool (1-4): se e' errato scrive un messaggio in console ed esce senza fare nulla
    {% if TOOL_HUMAN < 1 or TOOL_HUMAN > 4 %}
        M118 ERRORE: Numero tool non valido! Usa T=1, T=2, T=3 o T=4. Macro abortita.
    {% else %}

        # Conversione interna per Klipper (da umano 1-4 a indice reale 0-3)
        {% set TOOL = TOOL_HUMAN - 1 %}

        # 1. Preleva il tool
        M118 Avvio procedura per Tool {TOOL_HUMAN}...
        PRELEVA_TOOL T={TOOL_HUMAN}

        # 1.1. Riscaldamento
        M118 Riscaldamento Tool {TOOL_HUMAN} a {TEMP_PURGE}C per spurgo...
        M104 S{TEMP_PURGE} T{TOOL}

        # 2. Spostamento in sicurezza alle coordinate di spurgo
        M118 Posizionamento in sicurezza alle coordinate di spurgo...
        SAFE_Z_HOP MIN_Z=10
        G90
        G1 Y{Y_SPURGO} F{SPEED_XY}
        G1 X{X_SPURGO} F{SPEED_XY}
        M400

        # 3. Aspetto temp e Spurgo
        M109 S{TEMP_PURGE} T{TOOL}
        M118 Eseguisco spurgo di {PURGE_LENGTH} mm...
        G92 E0
        G1 E{PURGE_LENGTH} F{PURGE_FEEDRATE}
        M400

        # 4. Ritrazione anti-colatura
        M118 Eseguo ritrazione di {RETRACT_LENGTH} mm...
        G92 E0
        G1 E{RETRACT_LENGTH} F{RETRACT_FEEDRATE}
        M400

        # 5. Spegnimento immediato riscaldatore
        M118 Spengo riscaldatore...
        M104 S0 T{TOOL}

        # 6. Pulizia ugello subito (a caldo, prima del raffreddamento)
        M118 Pulizia ugello...
        CLEAN_NOZZLE

        # Protezione: solleva ad almeno 10mm prima di spostarsi verso il cuscinetto
        SAFE_Z_HOP MIN_Z=10

        # 7. Spostamento sul cuscinetto di silicone e attesa raffreddamento a 140C
        M118 Sposto sul cuscinetto di raffreddamento e attendo {TEMP_SAFE}C...
        G90
        G1 X250.0 F{SPEED_XY}
        G1 Y{Y_SILICONE} F{SPEED_XY}
        G1 X{X_SILICONE} F{SPEED_XY}
        G1 Z{Z_SILICONE} F{SPEED_Z}
        M400
        TEMPERATURE_WAIT SENSOR="extruder{ '' if TOOL == 0 else TOOL }" MAXIMUM={TEMP_SAFE|float}

        # 8. Protezione: risolleva ad almeno 10mm prima del deposito
        M118 Temperatura di sicurezza raggiunta. Sollevo in sicurezza...
        SAFE_Z_HOP MIN_Z=10

        # 9. Deposito finale del tool
        M118 Deposito il Tool {TOOL_HUMAN}...
        DEPOSITA_TOOL

        M118 Ciclo LOAD_FILAMENT completato con successo!

    {% endif %}

#################################################################################

[gcode_macro CLEAN_NOZZLE]
description: Pulisce l'ugello sul cuscinetto di pulizia. NON deposita il tool (va chiamato separatamente).
gcode:
    {% set START_Z_LIFT = 10.0 %}
    {% set STAGING_X = 250.0 %}
    {% set STAGING_Y = 0.0 %}
    {% set CLEAN_Z = 3.0 %}
    {% set X_LEFT = 263 %}
    {% set X_RIGHT = 270.0 %}
    {% set SPEED_Z = 600 %}
    {% set SPEED_MOVE = 4800 %}
    {% set SPEED_CLEAN = 2400 %}

    # Controllo tool montati
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}
    {% set ns = namespace(mounted=[]) %}
    {% for i in range(4) %}
        {% if grab[i] == "PRESSED" %}
            {% set _ = ns.mounted.append(i+1) %}
        {% endif %}
    {% endfor %}

    {% if ns.mounted | length > 0 %}
        # Protezione: assicura homing ed almeno 10mm dal piatto prima di muovere in XY
        SAFE_Z_HOP MIN_Z={START_Z_LIFT}

        # 2. Posiziona prima X, poi Y, poi X di avvicinamento (evita collisioni con i tool dockati)
        G1 X{STAGING_X} F{SPEED_MOVE}
        G1 Y{STAGING_Y} F{SPEED_MOVE}
        G1 X{X_RIGHT} F{SPEED_MOVE}

        # 3. Abbassa Z alla quota di pulizia
        G1 Z{CLEAN_Z} F{SPEED_Z}

        # 4. Ciclo di pulizia (avanti e indietro)
        {% for i in range(3) %}
            G1 X{X_LEFT} F{SPEED_CLEAN}
            G1 X{X_RIGHT} F{SPEED_CLEAN}
        {% endfor %}
        G1 X{X_LEFT} F{SPEED_CLEAN}

    {% else %}
        { action_raise_error("Errore: Nessun tool montato!") }
    {% endif %}

#################################################################################



[gcode_macro DISABILITA_MOTORI]
description: Spegne la coppia dei motori stepper (X, Y, Z ed estrusori) per muoverli a mano
gcode:
    M400                          # Attende la fine di tutti i movimenti in coda
    M84                           # Spegne tutti i motori stepper
    M118 Motori disabilitati. Carrello libero.



[gcode_macro SBLOCCA_XY]
description: Disabilita solo i motori X e Y mantenendo Z bloccato
gcode:
    M400
    SET_STEPPER_ENABLE STEPPER=stepper_x ENABLE=0
    SET_STEPPER_ENABLE STEPPER=stepper_y ENABLE=0
    # Se hai un secondo motore Y (es. stepper_y1), sblocca anche quello:
    # SET_STEPPER_ENABLE STEPPER=stepper_y1 ENABLE=0
    M118 Assi X e Y sbloccati.


[gcode_shell_command REBOOT_HOST]
command: /usr/data/home/pwned/reboot.sh
timeout: 5
verbose: True

[gcode_macro REBOOT_PRINTER]
variable_value: 0
gcode:
    RUN_SHELL_COMMAND CMD=REBOOT_HOST



[gcode_shell_command REBOOT_HOST_CMD]
command: /usr/data/home/pwned/host_reboot.sh
timeout: 2
verbose: True

[gcode_macro SAVE_AND_REBOOT]
gcode:
    RUN_SHELL_COMMAND CMD=REBOOT_HOST_CMD
    SAVE_CONFIG



