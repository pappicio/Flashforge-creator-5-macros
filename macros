#####IF YOU ENABLE HOMING_OVVERRYDE, you have to comment safe_z_home script on "printer.base.cfg
### THEM BOTH are in conflicts

### [safe_z_home]
### pin: PJ11
### home_xy_position: 130, 130
### speed: 200
### z_hop: 10
### z_hop_speed: 3
### move_to_previous: False



[homing_override]
axes: xyz
gcode:
    # -------------------------------------------------------------------
    # Abbassa il piatto di 10mm solo se sbloccato o sbloccando Z fittizio
    # -------------------------------------------------------------------
    {% if "z" not in printer.toolhead.homed_axes %}
        SET_KINEMATIC_POSITION Z=0
    {% endif %}
    G91
    G1 Z10 F600
    G90

    # -------------------------------------------------------------------
    # RILEVAMENTO TOOL MONTATO
    # -------------------------------------------------------------------
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}

    {% set ns = namespace(mounted=false) %}
    {% for state in grab %}
        {% if state == "PRESSED" %}
            {% set ns.mounted = true %}
        {% endif %}
    {% endfor %}

    {% set raw = rawparams|default('')|upper %}
    {% set home_all = (not 'X' in raw and not 'Y' in raw and not 'Z' in raw) %}
    {% set home_x = 'X' in raw or home_all %}
    {% set home_y = 'Y' in raw or home_all %}
    {% set home_z = 'Z' in raw or home_all %}

    # -------------------------------------------------------------------
    # SEQUENZA DI HOMING
    # -------------------------------------------------------------------
    {% if ns.mounted %}
        M118 Utensile rilevato! Eseguo Home XY...
        G28 X Y
        M118 Spostamento a X130 Y130 prima del deposito...
        G1 X130 Y130 F12000
        
        # Chiama direttamente l'helper fisico (MAI la macro pubblica DEPOSITA_TOOL)
        _DEPOSITA_TOOL_FISICO
        
        M118 Carrello vuoto. Ritorno a X130 Y130...
        G1 X130 Y130 F12000
        M118 Eseguo Home Z dopo aver depositato...
        G28 Z
        G91
        G1 Z10 F600
        G90
    {% else %}
        M118 Nessun utensile sul carrello.
        {% if home_all %}
            G28 X Y
            G1 X130 Y130 F12000
            G28 Z
            G91
            G1 Z10 F600
            G90
        {% else %}
            {% if home_x and home_y %}
                G28 X Y
            {% elif home_x %}
                G28 X
            {% elif home_y %}
                G28 Y
            {% endif %}

            {% if home_z %}
                {% if 'x' not in printer.toolhead.homed_axes or 'y' not in printer.toolhead.homed_axes %}
                    M118 Homing XY necessario prima di fare Home Z...
                    G28 X Y
                {% endif %}
                M118 Spostamento al centro X130 Y130 per Home Z...
                G1 X130 Y130 F12000
                G28 Z
                G91
                G1 Z10 F600
                G90
            {% elif home_x or home_y %}
                M118 Spostamento di sicurezza al centro X130 Y130...
                G1 X130 Y130 F12000
            {% endif %}
        {% endif %}
    {% endif %}


