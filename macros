# ====================================================================

[gcode_shell_command RESTART_KLIPPER_SHELL]
command: /bin/sh -c "/usr/prog/klipper/klipperDaemon restart >/dev/null 2>&1 &"
timeout: 5
verbose: False

[gcode_shell_command RESTART_MOONRAKER_SHELL]
command: /bin/sh -c "/usr/prog/klipper/moonrakerDaemon restart >/dev/null 2>&1 &"
timeout: 5
verbose: False

# ====================================================================
# MACRO ATTIVE IN MAINSAIL
# ====================================================================
# Timer disattivato all'avvio (duration = 0)

[delayed_gcode LED_AUTO_ON]
initial_duration: 10.0
gcode:
    SET_LED LED=chamber_led WHITE=0.5

# Macro Riavvia Moonraker
[gcode_macro RIAVVIA_MOONRAKER]
variable_value: 0
description: Riavvia il servizio Moonraker
gcode:
    RUN_SHELL_COMMAND CMD=RESTART_MOONRAKER_SHELL

# Macro Riavvia Klipper
[gcode_macro RIAVVIA_KLIPPER]
variable_value: 0
description: Riavvia il servizio Klipper
gcode:
    RUN_SHELL_COMMAND CMD=RESTART_KLIPPER_SHELL






