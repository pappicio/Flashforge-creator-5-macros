[gcode_macro CANCEL_PRINT]
description: Annulla la stampa corrente con abbassamento piatto, raffreddamento e deposito tool
rename_existing: CANCEL_PRINT_BASE
gcode:
    ##### Parametri client / Mainsail / Fluidd #####
    {% set client = printer['gcode_macro _CLIENT_VARIABLE']|default({}) %}
    {% set allow_park = client.park_at_cancel|default(false)|lower == 'true' %}
    {% set retract = client.cancel_retract|default(5.0)|abs %}

    # Ripristina l idle timeout se era in pausa
    {% if printer['gcode_macro RESUME'].restore_idle_timeout|default(0) > 0 %}
        SET_IDLE_TIMEOUT TIMEOUT={printer['gcode_macro RESUME'].restore_idle_timeout}
    {% endif %}

    # 1. Retrazione iniziale del filamento per evitare oozing
    _CLIENT_RETRACT LENGTH={retract}

    # 2. Abbassa SEMPRE il piatto di 10mm (sblocca Z con posizione fittizia se non homato)
    {% if "z" not in printer.toolhead.homed_axes %}
        M118 Asse Z non homato: imposto posizione temporanea per movimento di sicurezza...
        SET_KINEMATIC_POSITION Z=0
    {% endif %}
    M118 Abbasso il piatto di 10mm per sicurezza...
    G91
    G1 Z10 F600
    G90

    # 3. Spegne riscaldatori e ventola (l hotend comincia a raffreddarsi)
    TURN_OFF_HEATERS
    M106 S0

    # 4. Rileva se c e un utensile agganciato al carrello
    {% set grab = [
        printer["gcode_button extruder_grab1"].state,
        printer["gcode_button extruder_grab2"].state,
        printer["gcode_button extruder_grab3"].state,
        printer["gcode_button extruder_grab4"].state
    ] %}
    {% set ns = namespace(mounted=false) %}
    {% for state in grab %}
        {% if state == "PRESSED" %}
            {% set ns.mounted = true %}
        {% endif %}
    {% endfor %}

    # 5. Se l utensile e montato, attende i 140C prima di andare in dock
    {% if ns.mounted %}
        {% set current_extruder = printer.toolhead.extruder %}
        M118 Stampa annullata. Attendo raffreddamento {current_extruder} a 140C...
        TEMPERATURE_WAIT SENSOR={current_extruder} MAXIMUM=140
        M118 Temperatura raggiunta (<=140C). Deposito utensile in corso...
        DEPOSITA_TOOL
    {% else %}
        M118 Nessun utensile montato sul carrello.
    {% endif %}

    # 6. Disattiva i motori
    M84

    # Pulizia variabili e ripristino stato client Mainsail/Fluidd
    {client.user_cancel_macro|default("")}
    SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=idle_state VALUE=False
    SET_PAUSE_NEXT_LAYER ENABLE=0
    SET_PAUSE_AT_LAYER ENABLE=0 LAYER=0
    CANCEL_PRINT_BASE



