# ====================================================================
# 1. Override che neutralizza la scansione automatica Flashforge
# ====================================================================
[gcode_macro BED_MESH_CALIBRATE]
rename_existing: REAL_BED_MESH_CALIBRATE
gcode:
    M118 Intercettato comando Flashforge: livellamento ignorato. Uso mesh pre-salvata.

###########################################################################################
### PER USARLA IN AUTOMATICO DA SLICER; alla fine dello start gcode, aggiungere:
### CARICA_MESH_TEMPERATURA
### basta, cosi fatte le sue calibrazioni, la home ecc, carica la mesh idonea, e se nn la trova, va in errore (mostra errore in rosso su console mainsail)
### e dovrete creare una mesh atta a quelal TEMP del piatto!!!
### riavviate la stampa e sta volta carica mesh e avvia stampa!


### se volete caricare una mesh adattata alle varie temperature, esempio da 60 a 69, o da 70 a 79, dovrete prima eseguire una mesh con macro:
### SALVA_MESH_TEMPERATURA B=70 (B=60, B=80 ecc....)

# ====================================================================
# Macro per il caricamento dinamico della mesh con controllo di sicurezza
# ====================================================================
[gcode_macro CARICA_MESH_TEMPERATURA]
gcode:
    {% set BED_TEMP = printer.heater_bed.target|float %}

    # 1. Determinazione del nome profilo target
    {% if BED_TEMP >= 110 %}
        {% set MESH_TARGET = "110" %}
    {% elif BED_TEMP >= 100 %}
        {% set MESH_TARGET = "100" %}
    {% elif BED_TEMP >= 90 %}
        {% set MESH_TARGET = "90" %}
    {% elif BED_TEMP >= 80 %}
        {% set MESH_TARGET = "80" %}
    {% elif BED_TEMP >= 70 %}
        {% set MESH_TARGET = "70" %}
    {% elif BED_TEMP >= 60 %}
        {% set MESH_TARGET = "60" %}
    {% elif BED_TEMP >= 50 %}
        {% set MESH_TARGET = "50" %}
    {% else %}
        {% set MESH_TARGET = "40" %}
    {% endif %}

    # 2. Recupera la lista dei profili mesh salvati su disco
    {% set SALVATI = printer.bed_mesh.profiles %}

    # 3. Controllo ed eventuale caricamento o blocco stampa
    {% if MESH_TARGET in SALVATI %}
        M118 Caricamento mesh salvata per profilo {MESH_TARGET} (Target: {BED_TEMP}C)
        BED_MESH_PROFILE LOAD={MESH_TARGET}
    {% else %}
        M118 !!! ERRORE MESH MISSING !!! Profilo '{MESH_TARGET}' non trovato su disco.
        M118 Esegui prima: SALVA_MESH_TEMPERATURA B={BED_TEMP|int}
        CANCEL_PRINT
        { action_raise_error("Stampa annullata: profilazione mesh assente per " ~ MESH_TARGET ~ "C") }
    {% endif %}

