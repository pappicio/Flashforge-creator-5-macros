/usr/data/home/pwned/click_ok
/opt/bin/gcc -nostdlib -static /usr/data/home/pwned/click_ok.c /usr/data/home/pwned/c5-syscalls-v7.S -o /usr/data/home/pwned/click_ok
cat << 'EOF' > /usr/data/home/pwned/click_ok.c
#include <fcntl.h>
#include <unistd.h>
#include <linux/input.h>
#include <time.h>
static void send_event(int fd, __u16 type, __u16 code, __s32 value) {
    struct input_event ev;
    ev.time.tv_sec = 0;
    ev.time.tv_usec = 0;
    ev.type = type;
    ev.code = code;
    ev.value = value;
    write(fd, &ev, sizeof(ev));
}
int main(void) {
    int fd = open("/dev/input/event2", O_RDWR);
    if (fd < 0) return 1;
    // --- TOUCH DOWN ---
    send_event(fd, EV_KEY, 330, 1);    // BTN_TOUCH
    send_event(fd, EV_ABS, 53, 400);   // X = 400
    send_event(fd, EV_ABS, 54, 365);   // Y = 365
    send_event(fd, EV_ABS, 48, 20);    // TOUCH_MAJOR
    send_event(fd, EV_ABS, 50, 20);    // WIDTH_MAJOR
    send_event(fd, EV_ABS, 57, 0);     // TRACKING_ID
    send_event(fd, EV_SYN, 2, 0);      // SYN_MT_REPORT
    send_event(fd, EV_SYN, 0, 0);      // SYN_REPORT
    usleep(80000); // 80 ms
    // --- TOUCH UP ---
    send_event(fd, EV_KEY, 330, 0);    // BTN_TOUCH release
    send_event(fd, EV_SYN, 2, 0);      // SYN_MT_REPORT
    send_event(fd, EV_SYN, 0, 0);      // SYN_REPORT
    close(fd);
    return 0;
}
EOF
