# 1. Compilazione della libreria LD_PRELOAD
cat << 'EOF' > /usr/prog/mjpg-streamer/redirect_video.c
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include <fcntl.h>
#include <stdarg.h>
static int (*real_open)(const char *pathname, int flags, ...) = NULL;
static int (*real_openat)(int dirfd, const char *pathname, int flags, ...) = NULL;
int open(const char *pathname, int flags, ...) {
    if (!real_open) real_open = dlsym(RTLD_NEXT, "open");
    const char *target = pathname;
    if (pathname && strcmp(pathname, "/dev/video0") == 0) {
        target = "/dev/video1";
    }
    mode_t mode = 0;
    if (flags & O_CREAT) {
        va_list args;
        va_start(args, flags);
        mode = va_arg(args, mode_t);
        va_end(args);
        return real_open(target, flags, mode);
    }
    return real_open(target, flags);
}
int openat(int dirfd, const char *pathname, int flags, ...) {
    if (!real_openat) real_openat = dlsym(RTLD_NEXT, "openat");
    const char *target = pathname;
    if (pathname && strcmp(pathname, "/dev/video0") == 0) {
        target = "/dev/video1";
    }
    mode_t mode = 0;
    if (flags & O_CREAT) {
        va_list args;
        va_start(args, flags);
        mode = va_arg(args, mode_t);
        va_end(args);
        return real_openat(dirfd, target, flags);
    }
    return real_openat(dirfd, target, flags);
}
EOF
/opt/bin/gcc -shared -fPIC /usr/prog/mjpg-streamer/redirect_video.c -o /usr/prog/mjpg-streamer/libredirect_video.so -ldl
# 2. Creazione dello script start_webcam_test.sh
cat << 'EOF' > /usr/prog/mjpg-streamer/start_webcam_test.sh
#!/bin/sh
export LD_LIBRARY_PATH=/usr/prog/mjpg-streamer
(
  cd /usr/prog/mjpg-streamer || exit 1
  i=0
  while [ ! -e /dev/video0 ] && [ "$i" -lt 30 ]; do sleep 1; i=$((i+1)); done
  mkdir -p /usr/data/logs
  while true; do
    ./mjpg_streamer \
      -i "input_uvc.so -d /dev/video0 -r 1280x720 -f 30" \
      -o "output_http.so -p 8081 -w www" \
      >/usr/data/logs/mjpg.log 2>&1
    sleep 3
  done
) &
EOF
chmod +x /usr/prog/mjpg-streamer/start_webcam_test.sh
