cat << 'EOF' > /usr/prog/mjpg-streamer/fake_v4l2.c
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <dlfcn.h>
#include <fcntl.h>
#include <errno.h>
#include <sys/ioctl.h>
#include <linux/videodev2.h>
static int (*real_open)(const char *pathname, int flags, ...) = NULL;
static int (*real_ioctl)(int fd, unsigned long request, ...) = NULL;
static int fake_fd = -1;
__attribute__((constructor))
static void init(void) {
    real_open = dlsym(RTLD_NEXT, "open");
    real_ioctl = dlsym(RTLD_NEXT, "ioctl");
}
int open(const char *pathname, int flags, ...) {
    if (!real_open) init();
    if (pathname && strcmp(pathname, "/dev/video0") == 0) {
        fake_fd = real_open("/dev/null", flags);
        return fake_fd;
    }
    va_list args;
    va_start(args, flags);
    mode_t mode = va_arg(args, mode_t);
    va_end(args);
    return real_open(pathname, flags, mode);
}
int ioctl(int fd, unsigned long request, void *arg) {
    if (!real_ioctl) init();
    if (fd != fake_fd || fake_fd == -1) {
        return real_ioctl(fd, request, arg);
    }
    switch (request) {
        case VIDIOC_QUERYCAP: {
            struct v4l2_capability *cap = (struct v4l2_capability *)arg;
            memset(cap, 0, sizeof(*cap));
            snprintf((char *)cap->driver, sizeof(cap->driver), "fake_v4l2");
            snprintf((char *)cap->card, sizeof(cap->card), "Fake USB Camera");
            cap->capabilities = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING;
            cap->device_caps = cap->capabilities;
            return 0;
        }
        case VIDIOC_G_FMT:
        case VIDIOC_S_FMT:
        case VIDIOC_TRY_FMT: {
            struct v4l2_format *fmt = (struct v4l2_format *)arg;
            if (fmt && fmt->type == V4L2_BUF_TYPE_VIDEO_CAPTURE) {
                fmt->fmt.pix.width = 1280;
                fmt->fmt.pix.height = 720;
                fmt->fmt.pix.pixelformat = V4L2_PIX_FMT_MJPEG;
                fmt->fmt.pix.field = V4L2_FIELD_NONE;
                fmt->fmt.pix.bytesperline = 1280 * 2;
                fmt->fmt.pix.sizeimage = 1280 * 720 * 2;
                return 0;
            }
            break;
        }
        case VIDIOC_REQBUFS: {
            struct v4l2_requestbuffers *req = (struct v4l2_requestbuffers *)arg;
            if (req) req->count = 2;
            return 0;
        }
        case VIDIOC_QUERYBUF: {
            struct v4l2_buffer *buf = (struct v4l2_buffer *)arg;
            if (buf) {
                buf->length = 1280 * 720 * 2;
                buf->m.offset = 0;
            }
            return 0;
        }
        case VIDIOC_STREAMON:
        case VIDIOC_STREAMOFF:
        case VIDIOC_QBUF:
        case VIDIOC_DQBUF:
            return 0;
        default:
            return 0;
    }
    return 0;
}
EOF
