cat << 'EOF' > /usr/data/home/pwned/click_center.py
import struct
import time
import sys
EVENT_FILE = "/dev/input/event2"
def send_event(f, ev_type, code, value):
    t = time.time()
    tv_sec = int(t)
    tv_usec = int((t - tv_sec) * 1000000)
    buf = struct.pack('llHHi', tv_sec, tv_usec, ev_type, code, value)
    f.write(buf)
def click_screen():
    time.sleep(1.0)
    
    # Centro esatto per schermo 800x480
    center_x = 400
    center_y = 240
    
    try:
        with open(EVENT_FILE, "wb", buffering=0) as f:
            send_event(f, 3, 0x35, center_x)  # ABS_MT_POSITION_X
            send_event(f, 3, 0x36, center_y)  # ABS_MT_POSITION_Y
            send_event(f, 1, 0x14a, 1)        # BTN_TOUCH down
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            time.sleep(0.08)
            
            send_event(f, 1, 0x14a, 0)        # BTN_TOUCH up
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            print("Click 800x480 inviato con successo!")
    except Exception as e:
        print(f"Errore durante l'invio dell'evento: {e}")
if __name__ == "__main__":
    click_screen()
EOF
