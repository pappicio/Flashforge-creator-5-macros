  -i "/usr/prog/mjpg-streamer/input_uvc.so -d /dev/video0 -r 1280x720 -f 30" \
  -o "/usr/prog/mjpg-streamer/output_http.so -p 8081 -w /usr/prog/mjpg-streamer/www"
/usr/prog/mjpg-streamer/mjpg_streamer \
