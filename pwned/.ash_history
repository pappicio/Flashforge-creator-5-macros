#define SYS_open   4005
#define SYS_openat 4288
typedef unsigned int mode_t;
static inline long my_syscall3(long n, long a1, long a2, long a3) {
    register long r4 __asm__("$4") = a1;
    register long r5 __asm__("$5") = a2;
    register long r6 __asm__("$6") = a3;
    register long r2 __asm__("$2") = n;
    __asm__ __volatile__(
        "syscall\n"
        : "+r"(r2)
        : "r"(r4), "r"(r5), "r"(r6)
        : "memory"
    );
    return r2;
}
static inline long my_syscall4(long n, long a1, long a2, long a3, long a4) {
    register long r4 __asm__("$4") = a1;
    register long r5 __asm__("$5") = a2;
    register long r6 __asm__("$6") = a3;
    register long r7 __asm__("$7") = a4;
    register long r2 __asm__("$2") = n;
    __asm__ __volatile__(
        "syscall\n"
        : "+r"(r2)
        : "r"(r4), "r"(r5), "r"(r6), "r"(r7)
        : "memory"
    );
    return r2;
}
static int my_strcmp(const char *s1, const char *s2) {
    while (*s1 && (*s1 == *s2)) { s1++; s2++; }
    return *(unsigned char *)s1 - *(unsigned char *)s2;
}
static const char* check_target(const char *pathname) {
    if (pathname && my_strcmp(pathname, "/dev/video0") == 0) {
        return "/dev/video1";
    }
    return pathname;
}
int open(const char *pathname, int flags, ...) {
    return (int)my_syscall3(SYS_open, (long)check_target(pathname), (long)flags, 0);
}
int open64(const char *pathname, int flags, ...) {
    return open(pathname, flags);
}
int openat(int dirfd, const char *pathname, int flags, ...) {
    return (int)my_syscall4(SYS_openat, (long)dirfd, (long)check_target(pathname), (long)flags, 0);
}
