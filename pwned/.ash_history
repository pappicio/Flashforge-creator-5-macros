cat << 'EOF' > /usr/data/home/pwned/click_center.py
import struct
import time
import sys
EVENT_FILE = "/dev/input/event2"
def send_event(f, ev_type, code, value):
    # Timestamp a zero come nel codice C originale
    buf = struct.pack('llHHi', 0, 0, ev_type, code, value)
    f.write(buf)
    f.flush()
def click_screen():
    # Attesa per il boot della GUI
    time.sleep(2.0)
    
    # Coordinate del tasto OK sul popup (circa X=400, Y=365 su schermo 800x480)
    target_x = 400
    target_y = 365
    
    print(f"Invio sequenza Goodix completa su X={target_x}, Y={target_y}")
    try:
        with open(EVENT_FILE, "wb") as f:
            # --- TOUCH DOWN (Sequenza identica al driver nativo C) ---
            send_event(f, 1, 330, 1)          # BTN_TOUCH (330) = 1
            send_event(f, 3, 53, target_x)    # ABS_MT_POSITION_X (53)
            send_event(f, 3, 54, target_y)    # ABS_MT_POSITION_Y (54)
            send_event(f, 3, 48, 20)          # ABS_MT_TOUCH_MAJOR (48) = 20
            send_event(f, 3, 50, 20)          # ABS_MT_WIDTH_MAJOR (50) = 20
            send_event(f, 3, 57, 0)           # ABS_MT_TRACKING_ID (57) = 0
            send_event(f, 0, 2, 0)            # SYN_MT_REPORT (2)
            send_event(f, 0, 0, 0)            # SYN_REPORT (0)
            
            # Pausa di pressione di circa 80ms
            time.sleep(0.08)
            
            # --- TOUCH UP ---
            send_event(f, 1, 330, 0)          # BTN_TOUCH (330) = 0
            send_event(f, 0, 2, 0)            # SYN_MT_REPORT (2)
            send_event(f, 0, 0, 0)            # SYN_REPORT (0)
            
            print("Sequenza Goodix inviata con successo.")
    except Exception as e:
        print(f"Errore: {e}")
if __name__ == "__main__":
    click_screen()
EOF
python3 /usr/data/home/pwned/click_center.py
which gcc
cat << 'EOF' > /usr/data/home/pwned/click_ok.c
#define O_RDWR 2
#define EV_SYN 0
#define EV_KEY 1
#define EV_ABS 3
#define SYN_REPORT          0
#define SYN_MT_REPORT       2
#define BTN_TOUCH           330
#define ABS_MT_TOUCH_MAJOR  48
#define ABS_MT_WIDTH_MAJOR  50
#define ABS_MT_POSITION_X   53
#define ABS_MT_POSITION_Y   54
#define ABS_MT_TRACKING_ID  57
struct c5_input_event {
    long tv_sec;
    long tv_usec;
    unsigned short type;
    unsigned short code;
    int value;
};
struct c5_timespec {
    long tv_sec;
    long tv_nsec;
};
extern long c5_open(const char *caminho, long flags, long modo);
extern long c5_write(long fd, const void *buffer, long tamanho);
extern long c5_close(long fd);
extern long c5_nanosleep(const void *pedido, void *restante);
extern void c5_exit(long codigo);
static long enviar_evento(long fd_touch, unsigned short type, unsigned short code, int value) {
    struct c5_input_event ev;
    ev.tv_sec = 0;
    ev.tv_usec = 0;
    ev.type = type;
    ev.code = code;
    ev.value = value;
    return c5_write(fd_touch, &ev, sizeof(ev));
}
void _start(void) {
    long fd_touch;
    int target_x = 400; // X per il tasto OK
    int target_y = 365; // Y per il tasto OK
    
    struct c5_timespec duracao = { 0, 80000000 }; // 80 ms
    fd_touch = c5_open("/dev/input/event2", O_RDWR, 0);
    if (fd_touch < 0) {
        c5_exit(1);
    }
    // --- TOUCH DOWN ---
    enviar_evento(fd_touch, EV_KEY, BTN_TOUCH, 1);
    enviar_evento(fd_touch, EV_ABS, ABS_MT_POSITION_X, target_x);
    enviar_evento(fd_touch, EV_ABS, ABS_MT_POSITION_Y, target_y);
    enviar_evento(fd_touch, EV_ABS, ABS_MT_TOUCH_MAJOR, 20);
    enviar_evento(fd_touch, EV_ABS, ABS_MT_WIDTH_MAJOR, 20);
    enviar_evento(fd_touch, EV_ABS, ABS_MT_TRACKING_ID, 0);
    enviar_evento(fd_touch, EV_SYN, SYN_MT_REPORT, 0);
    enviar_evento(fd_touch, EV_SYN, SYN_REPORT, 0);
    c5_nanosleep(&duracao, 0);
    // --- TOUCH UP ---
    enviar_evento(fd_touch, EV_KEY, BTN_TOUCH, 0);
    enviar_evento(fd_touch, EV_SYN, SYN_MT_REPORT, 0);
    enviar_evento(fd_touch, EV_SYN, SYN_REPORT, 0);
    c5_close(fd_touch);
    c5_exit(0);
}
EOF
