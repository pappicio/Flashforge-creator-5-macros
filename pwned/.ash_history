#
# Start klipper 
#
PYTHON=/usr/prog/Python-3.8.2/bin/python3
KLIPPER=/usr/prog/klipper/klippy/klippy.py
KLIPPER_CONF=/usr/data/config/printer.cfg
KLIPPER_LOG=/usr/data/logs/printer.log
PID_FILE=/run/klipper.pid
KLIPPER_UDS=/tmp/uds
KLIPPER_NICENESS=-20
start() {
    mkdir -p $(dirname $KLIPPER_LOG)
    
    # Pulizia preventiva per garantire l'avvio pulito
    rm -f $KLIPPER_UDS $PID_FILE
    
    start-stop-daemon -S -b -m -p $PID_FILE -N $KLIPPER_NICENESS --exec $PYTHON -- $KLIPPER $KLIPPER_CONF -l $KLIPPER_LOG -a $KLIPPER_UDS
}
stop() {
    # Tenta lo stop pulito
    start-stop-daemon -K -p $PID_FILE 2>/dev/null
    sleep 1
    
    # Se il processo Python è ancora vivo, forza il kill
    if [ -f $PID_FILE ]; then
        PID=$(cat $PID_FILE 2>/dev/null)
        if [ -n "$PID" ] && kill -0 $PID 2>/dev/null; then
            kill -9 $PID 2>/dev/null
        fi
        rm -f $PID_FILE
    fi
    
    # Rimuove il socket obsoleto per sbloccare Moonraker
    rm -f $KLIPPER_UDS
}
restart() {
    stop
    sleep 2
    start
    sleep 2
    
    # Ripristino webcam in background senza bloccare Klipper
    if [ -x /usr/prog/mjpg-streamer/fix_webcam.sh ]; then
        /usr/prog/mjpg-streamer/fix_webcam.sh >/dev/null 2>&1 &
    fi
}
case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        restart
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
#!/bin/sh
#
# Start klipper 
#
PYTHON=/usr/prog/Python-3.8.2/bin/python3
KLIPPER=/usr/prog/klipper/klippy/klippy.py
KLIPPER_CONF=/usr/data/config/printer.cfg
KLIPPER_LOG=/usr/data/logs/printer.log
PID_FILE=/run/klipper.pid
KLIPPER_UDS=/tmp/uds
KLIPPER_NICENESS=-20
start() {
    mkdir -p $(dirname $KLIPPER_LOG)
    
    # Pulizia preventiva per garantire l'avvio pulito
    rm -f $KLIPPER_UDS $PID_FILE
    
    start-stop-daemon -S -b -m -p $PID_FILE -N $KLIPPER_NICENESS --exec $PYTHON -- $KLIPPER $KLIPPER_CONF -l $KLIPPER_LOG -a $KLIPPER_UDS
}
stop() {
    # Tenta lo stop pulito
    start-stop-daemon -K -p $PID_FILE 2>/dev/null
    sleep 1
    
    # Se il processo Python è ancora vivo, forza il kill
    if [ -f $PID_FILE ]; then
        PID=$(cat $PID_FILE 2>/dev/null)
        if [ -n "$PID" ] && kill -0 $PID 2>/dev/null; then
            kill -9 $PID 2>/dev/null
        fi
        rm -f $PID_FILE
    fi
    
    # Rimuove il socket obsoleto per sbloccare Moonraker
    rm -f $KLIPPER_UDS
}
restart() {
    stop
    sleep 2
    start
    sleep 2
    
    # Ripristino webcam in background senza bloccare Klipper
    if [ -x /usr/prog/mjpg-streamer/fix_webcam.sh ]; then
        /usr/prog/mjpg-streamer/fix_webcam.sh >/dev/null 2>&1 &
    fi
}
case "$1" in
  start)
        start
        ;;
  stop)
        stop
        ;;
  restart|reload)
        restart
        ;;
  *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac
