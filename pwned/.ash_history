cat << 'EOF' > /usr/data/home/pwned/c5-syscalls-v7.S
    .set noreorder
    .set noat
    .text
    .globl c5_open
    .ent c5_open
c5_open:
    li      $v0, 4005
    syscall
    nop
    beq     $a3, $zero, c5_open_ok
    nop
    subu    $v0, $zero, $v0
c5_open_ok:
    jr      $ra
    nop
    .end c5_open
    .globl c5_write
    .ent c5_write
c5_write:
    li      $v0, 4004
    syscall
    nop
    beq     $a3, $zero, c5_write_ok
    nop
    subu    $v0, $zero, $v0
c5_write_ok:
    jr      $ra
