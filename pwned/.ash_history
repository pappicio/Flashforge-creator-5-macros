cmd_mcu write_firmware /usr/prog/libmcu-bare.bin
cmd_mcu bootup
sleep 2
echo "[3/5] Reset bus MCU secondarie (eboard/levelboard)..."
/usr/prog/klipper/checkEboard
sleep 1
echo "[4/5] Avvio Klipper Daemon..."
/usr/prog/klipper/klipperDaemon start
sleep 3
echo "[5/5] Avvio Nginx e Moonraker Daemon..."
/usr/prog/nginx/sbin/nginx -p /usr/prog/nginx -c /usr/prog/nginx/conf/nginx.conf 2>/dev/null
/usr/prog/klipper/moonrakerDaemon start
echo "--- Ripristino completato! ---"
EOF
