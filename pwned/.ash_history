cat << 'EOF' > /usr/data/home/pwned/click_center.py
import struct
import time
import sys
import random
EVENT_FILE = "/dev/input/event2"
def send_event(f, ev_type, code, value):
    t = time.time()
    tv_sec = int(t)
    tv_usec = int((t - tv_sec) * 1000000)
    buf = struct.pack('llHHi', tv_sec, tv_usec, ev_type, code, value)
    f.write(buf)
    f.flush() # Forza la scrittura immediata
def click_screen():
    # Attesa lunga per il boot
    time.sleep(2.0)
    
    # Coordinate leggermente riviste per il tasto OK (X: 400, Y: 365)
    # Proviamo ad aggiungere un leggero scostamento casuale per evitare filtri anti-bot
    target_x = 400 + random.randint(-2, 2)
    target_y = 365 + random.randint(-2, 2)
    
    print(f"Tentativo click su coordinate virtuali: X={target_x}, Y={target_y}")
    try:
        with open(EVENT_FILE, "wb") as f:
            # 1. Tocco Iniziale
            send_event(f, 3, 0x35, target_x)  # ABS_MT_POSITION_X
            send_event(f, 3, 0x36, target_y)  # ABS_MT_POSITION_Y
            send_event(f, 1, 0x14a, 1)        # BTN_TOUCH down
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            # Pausa "umana" di 150ms per il riconoscimento del tocco
            time.sleep(0.15)
            
            # 2. Rilascio Tocco
            send_event(f, 1, 0x14a, 0)        # BTN_TOUCH up
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            print("Sequenza di click inviata.")
            
            # Breve pausa di assestamento
            time.sleep(0.5)
            
            # Eventuale secondo tentativo per sicurezza (opzionale, decommenta se serve)
            # send_event(f, 1, 0x14a, 1)
            # send_event(f, 0, 0, 0)
            # time.sleep(0.05)
            # send_event(f, 1, 0x14a, 0)
            # send_event(f, 0, 0, 0)
            # print("Secondo click di sicurezza inviato.")
    except PermissionError:
        print("ERRORE: Permesso negato su /dev/input/event2. Esegui come root.")
    except Exception as e:
        print(f"Errore critico: {e}")
if __name__ == "__main__":
    click_screen()
EOF
