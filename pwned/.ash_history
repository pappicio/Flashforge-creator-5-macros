import struct
import time
import sys
EVENT_FILE = "/dev/input/event2"
def send_event(f, ev_type, code, value):
    t = time.time()
    tv_sec = int(t)
    tv_usec = int((t - tv_sec) * 1000000)
    buf = struct.pack('llHHi', tv_sec, tv_usec, ev_type, code, value)
    f.write(buf)
def click_screen():
    # Attende 1 secondo per il boot
    time.sleep(1.0)
    
    # Coordinate precise per il tasto OK sul popup (schermo 800x480)
    # X: centro schermo (400)
    # Y: parte bassa del popup (circa 360)
    target_x = 400
    target_y = 360
    
    try:
        with open(EVENT_FILE, "wb", buffering=0) as f:
            # Eventi di pressione Goodix standard
            send_event(f, 3, 0x35, target_x)  # ABS_MT_POSITION_X
            send_event(f, 3, 0x36, target_y)  # ABS_MT_POSITION_Y
            send_event(f, 1, 0x14a, 1)        # BTN_TOUCH down
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            # Pausa leggermente più lunga per assicurarsi che il click venga registrato (80ms)
            time.sleep(0.08)
            
            # Eventi di rilascio
            send_event(f, 1, 0x14a, 0)        # BTN_TOUCH up
            send_event(f, 0, 0, 0)            # SYN_REPORT
            
            print(f"Click inviato su coordinate ({target_x}, {target_y}) per tasto OK.")
    except Exception as e:
        print(f"Errore durante l'invio dell'evento: {e}")
if __name__ == "__main__":
    click_screen()
