#!/bin/sh
# 1. Kill totale dello script e di mjpg_streamer
ps | grep start_webcam.sh | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
sleep 1
# 2. Scarica il modulo uvcvideo se presente (pulisce il buffer del kernel)
rmmod uvcvideo 2>/dev/null
sleep 1
# 3. Unbind / Bind della porta USB con pause piu lunghe per far scaricare i condensatori del sensore
if [ -d /sys/bus/usb/drivers/usb/1-1.2 ]; then
    echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
    sleep 3
    echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
    sleep 2
fi
# 4. Ricarica il driver kernel e attendi che il nodo /dev/video0 sia pronto
modprobe uvcvideo 2>/dev/null || insmod /lib/modules/$(uname -r)/kernel/drivers/media/usb/uvc/uvcvideo.ko 2>/dev/null
sleep 1
# 5. Riavvia lo streamer pulito
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
ps | grep -E "webcam|mjpg|stream|sys_start" | grep -v grep
kill -9 5794 5796 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
ps | grep -E "webcam|mjpg" | grep -v grep
# 1. Reset della porta USB (stacco e riattacco logico)
echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
sleep 3
echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
sleep 2
# 2. Riavvio pulito dello streamer
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
# 1. Kill secco dello streamer e dello script
killall -9 mjpg_streamer 2>/dev/null
kill -9 $(ps | grep start_webcam.sh | grep -v grep | awk '{print $1}') 2>/dev/null
# 2. Reset hardware porta USB (quello esatto che ha funzionato prima)
echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
sleep 2
echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
sleep 1
ps | grep -E "webcam|mjpg" | grep -v grep
ps | grep webcam | grep -v grep
ps | grep webcam | grep -v grep | awk '{print $1}'
ps | grep webcam
ps | grep -E "stream|cam|video|8080"
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
killall -9 mjpg_streamer 2>/dev/null
kill -9 $(ps | grep -E "start_webcam|mjpg" | grep -v grep | awk '{print $1}') 2>/dev/null
sleep 1
echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
sleep 2
echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
sleep 1
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
ps | grep -v "ps\|grep" | grep -E "video|uvc|mjpg|webcam|camera|stream|sys_start|1091|3071"
ls -l /dev/video* /dev/v4l/by-id/* 2>/dev/null
# 1. Kill mirato di script e streamer
kill -9 7073 7075 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
ps | grep -E "start_webcam|mjpg" | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
sleep 1
# 2. Hard Reset dell'HUB USB PADRE (toglie alimentazione a 5V)
if [ -d /sys/bus/usb/drivers/usb/1-1 ]; then
    echo "1-1" > /sys/bus/usb/drivers/usb/unbind
    sleep 3
    echo "1-1" > /sys/bus/usb/drivers/usb/bind
    sleep 2
else
    echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
    sleep 3
    echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
    sleep 2
fi
# 3. Pulizia di eventuali lock sul file di dispositivo
fuser -k /dev/video0 /dev/video1 2>/dev/null
sleep 1
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
# 1. Kill mirato di script e streamer
kill -9 7073 7075 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
ps | grep -E "start_webcam|mjpg" | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
sleep 1
# 2. Hard Reset dell'HUB USB PADRE (toglie alimentazione a 5V)
if [ -d /sys/bus/usb/drivers/usb/1-1 ]; then
    echo "1-1" > /sys/bus/usb/drivers/usb/unbind
    sleep 3
    echo "1-1" > /sys/bus/usb/drivers/usb/bind
    sleep 2
else
    echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
    sleep 3
    echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
    sleep 2
fi
# 3. Pulizia di eventuali lock sul file di dispositivo
fuser -k /dev/video0 /dev/video1 2>/dev/null
ps | grep -v "ps\|grep" | grep -E "video|uvc|mjpg|webcam|camera|stream|sys_start|1091|3071"
# 1. Reset hardware dell'hub USB (spegne l'alimentazione al sensore)
echo "1-1" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null || echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
sleep 3
echo "1-1" > /sys/bus/usb/drivers/usb/bind 2>/dev/null || echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
sleep 2
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
# 1. Kill totale
killall -9 mjpg_streamer 2>/dev/null
ps | grep start_webcam | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
sleep 1
# 2. Avvio manuale forzato su /dev/video1
cd /usr/prog/mjpg-streamer
./mjpg_streamer -i "input_uvc.so -d /dev/video1 -r 1280x720 -f 15" -o "output_http.so -w ./www -p 8080" >/dev/null 2>&1 &
# 1. Kill totale
killall -9 mjpg_streamer 2>/dev/null
ps | grep start_webcam | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
sleep 1
# 2. Avvio manuale forzando formato MJPEG (-y 0)
cd /usr/prog/mjpg-streamer
./mjpg_streamer -i "input_uvc.so -d /dev/video0 -y 0 -r 1280x720 -f 15" -o "output_http.so -w ./www -p 8080" >/dev/null 2>&1 &
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
cat /usr/prog/mjpg-streamer/start_webcam.sh
export LD_LIBRARY_PATH=/usr/prog/mjpg-streamer
# 1. Killiamo PRIMA lo script padre (per spegnere il loop 'while true') e POI mjpg_streamer
ps | grep start_webcam.sh | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
sleep 1
# 2. Reset logico della porta USB 1-1.2
if [ -d /sys/bus/usb/drivers/usb/1-1.2 ]; then
    echo "1-1.2" > /sys/bus/usb/drivers/usb/unbind
    sleep 2
    echo "1-1.2" > /sys/bus/usb/drivers/usb/bind
    sleep 1
fi
# 3. Riavvio pulito dello script originale
/bin/sh /usr/prog/mjpg-streamer/start_webcam.sh >/dev/null 2>&1 &
/usr/prog/mjpg-streamer/fix_webcam.sh
# 1. Spegniamo il loop e lo streamer
ps | grep start_webcam.sh | grep -v grep | awk '{print $1}' | xargs kill -9 2>/dev/null
killall -9 mjpg_streamer 2>/dev/null
sleep 1
# 2. Esportiamo le librerie
export LD_LIBRARY_PATH=/usr/prog/mjpg-streamer
cd /usr/prog/mjpg-streamer
# 3. Lanciamo mjpg_streamer a 10 FPS in modalità MJPEG (-m)
./mjpg_streamer -i "input_uvc.so -d /dev/video0 -r 1280x720 -f 10 -m" -o "output_http.so -p 8080 -w www" >/usr/data/logs/mjpg.log 2>&1 &
./mjpg_streamer \
      -i "input_uvc.so -d /dev/video0 -r 1280x720 -f 30" \
      -o "output_http.so -p 8080 -w www" \
