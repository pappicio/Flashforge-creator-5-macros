cat << 'EOF' > /usr/prog/mjpg-streamer/redirect_video.c
#define _GNU_SOURCE
#include <sys/syscall.h>
#include <unistd.h>
#include <fcntl.h>
#include <stdarg.h>
static int my_strcmp(const char *s1, const char *s2) {
    while (*s1 && (*s1 == *s2)) { s1++; s2++; }
    return *(unsigned char *)s1 - *(unsigned char *)s2;
}
static const char* check_target(const char *pathname) {
    if (pathname && my_strcmp(pathname, "/dev/video0") == 0) {
        return "/dev/video1";
    }
    return pathname;
}
int open(const char *pathname, int flags, ...) {
    const char *target = check_target(pathname);
    mode_t mode = 0;
    if (flags & O_CREAT) {
        va_list args;
        va_start(args, flags);
        mode = va_arg(args, mode_t);
        va_end(args);
        return syscall(SYS_open, target, flags, mode);
    }
    return syscall(SYS_open, target, flags);
}
int open64(const char *pathname, int flags, ...) {
    return open(pathname, flags);
}
int openat(int dirfd, const char *pathname, int flags, ...) {
    const char *target = check_target(pathname);
    mode_t mode = 0;
    if (flags & O_CREAT) {
        va_list args;
        va_start(args, flags);
        mode = va_arg(args, mode_t);
        va_end(args);
        return syscall(SYS_openat, dirfd, target, flags, mode);
    }
    return syscall(SYS_openat, dirfd, target, flags);
}
EOF
