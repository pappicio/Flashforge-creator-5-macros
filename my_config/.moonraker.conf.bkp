[timelapse]
frame_path = /tmp/timelapse/
output_path = /usr/data/firmwareRes/camera/video/
ffmpeg_binary_path = /opt/bin/ffmpeg

[power Riavvia_stampante]
type = klipper_device
object_name = gcode_macro REBOOT_PRINTER
locked_while_printing = False

[power Riavvia_Klipper]
type = klipper_device
object_name = gcode_macro RIAVVIA_KLIPPER
locked_while_printing = True

[power Riavvia_Moonraker]
type = klipper_device
object_name = gcode_macro RIAVVIA_MOONRAKER
locked_while_printing = True

[server]
host = 0.0.0.0
port = 7125
klippy_uds_address = /tmp/uds

[machine]
provider = none
validate_service = false
validate_config = false

[file_manager]
file_system_observer = none

[authorization]
enable_api_key = false
trusted_clients = 
	0.0.0.0/0

